<?xml version="1.0" encoding="utf-8"?>
<!--
  Retheme of the Google native ad templates.

  These names come from googlemobileads-unity.aar (res/values/values.xml). This folder is added to
  unityLibrary's OWN resource set by mainTemplate.gradle, and a module's resources always beat those
  of its dependencies — which is why an .androidlib could not do this job: sibling libraries have no
  guaranteed priority over each other.

  Reaches the parts NativeTemplateStyle cannot: the white card behind the ad, its 2dp outline, and
  the hardcoded white background on the body row.

  Originals: gnt_white #FFFFFF, gnt_outline #E0E0E0, gnt_blue #4285f4,
             gnt_gray #808080, gnt_ad_green #3A6728
-->
<resources>
    <!-- Proof the folder made it into the build. Referenced by nothing. -->
    <color name="neon_ad_theme_marker">#FF00FF00</color>

    <!-- Transparent, not a colour. This name backs both the card behind the whole ad AND the
         hardcoded background on the text rows, so any solid value paints visible boxes on top of
         whatever MainBackgroundColor already drew. Letting it through leaves one clean surface. -->
    <color name="gnt_white">#00000000</color>

    <!-- The 2dp outline. Dim on purpose: a neon edge here fights the game's own card frames. -->
    <color name="gnt_outline">#1B2A4A</color>

    <!-- Call to action. -->
    <color name="gnt_blue">#00E5FF</color>

    <!-- Fallback text colour and the rating bar tint. -->
    <color name="gnt_gray">#9FB0C7</color>

    <!-- The "Ad" badge's text and border. -->
    <color name="gnt_ad_green">#00E5FF</color>
</resources>
