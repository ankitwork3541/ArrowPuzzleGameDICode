<?xml version="1.0" encoding="utf-8"?>
<!--
  Light paper theme for the Google native ad templates. The names are Google's and must stay, even
  where they read wrong now (gnt_dark_bg holds cream). This is half the theme: the text and button
  colours are set at runtime by PromoNativeUnit.BuildStyle(). The card colour is needed here because
  the plugin shares one background drawable between four views, so the runtime card colour only
  paints behind the body text and this one shows through everywhere else.
-->
<resources>
    <!-- Marker -->
    <color name="neon_ad_theme_marker">#FF00FF00</color>

    <!-- White text and accents -->
    <color name="gnt_white">#FFFFFF</color>

    <!-- Container outline -->
    <color name="gnt_outline">#E8DCC8</color>

    <!-- Call to action button background: lantern red -->
    <color name="gnt_blue">#C43448</color>

    <!-- Muted ink secondary text -->
    <color name="gnt_gray">#7D6B60</color>

    <!-- "Ad" badge border and text, rating stars: dark gold -->
    <color name="gnt_ad_green">#965C00</color>

    <!-- Card background: cream, same as BuildStyle -->
    <color name="gnt_dark_bg">#FFFCF4</color>

    <!-- CTA button text: cream on red -->
    <color name="gnt_cta_text">#FFF8EC</color>

    <!-- Body description text: ink -->
    <color name="gnt_body_text">#5A4234</color>
</resources>
