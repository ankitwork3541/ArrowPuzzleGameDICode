<?xml version="1.0" encoding="utf-8"?>
<!--
  Retheme of the Google native ad templates to match neon cyberpunk / dark sci-fi aesthetic.
-->
<resources>
    <!-- Marker -->
    <color name="neon_ad_theme_marker">#FF00FF00</color>

    <!-- White text and accents -->
    <color name="gnt_white">#FFFFFF</color>

    <!-- Dark container outline -->
    <color name="gnt_outline">#1B2A4A</color>

    <!-- Call to action button background & neon accents -->
    <color name="gnt_blue">#00E5FF</color>

    <!-- Cool gray secondary text and rating stars -->
    <color name="gnt_gray">#9FB0C7</color>

    <!-- "Ad" badge border and text color -->
    <color name="gnt_ad_green">#00E5FF</color>

    <!-- Theme card background -->
    <color name="gnt_dark_bg">#0C122A</color>

    <!-- CTA button text color (high contrast dark navy on cyan) -->
    <color name="gnt_cta_text">#050B18</color>

    <!-- Body description text color (bright readable cool blue-gray) -->
    <color name="gnt_body_text">#C5D1E8</color>
</resources>
