<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
>
    <Style src="/Assets/Project/Themes/HomeScreen.uss" />
    <Style src="/Assets/Project/Themes/Typography.uss" />
    <ui:VisualElement name="home-root" style="flex-grow: 1; background-color: rgb(5, 8, 22); align-items: center;">
        <ui:VisualElement name="grid-background" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; padding-bottom: 80px;">
            <ui:VisualElement style="width: 90%; max-width: 620px; align-items: center;">
                <ui:Label text="LEVEL 01" class="text-heading" style="color: rgb(0, 229, 255);" />
                <ui:VisualElement name="difficulty-pill" style="margin-top: 18px; min-width: 150px; min-height: 64px; padding-left: 32px; padding-right: 32px; justify-content: center; align-items: center; border-width: 3px; border-color: rgba(0, 229, 255, 0.4); background-color: rgb(8, 13, 32); border-radius: 32px;">
                    <ui:Label text="EASY" style="color: rgb(0, 229, 255); font-size: 20px; -unity-font-style: bold; letter-spacing: 2px;" />
                </ui:VisualElement>
                <ui:VisualElement name="play-button" style="margin-top: 36px; width: 84%; max-width: 480px; min-height: 96px; background-color: rgb(16, 21, 45); border-width: 3px; border-color: rgb(0, 229, 255); border-radius: 48px; justify-content: center; align-items: center;">
                    <ui:Label text="PLAY  ›" class="text-button" style="color: rgb(255, 255, 255); letter-spacing: 1px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;" />
        <ui:VisualElement name="bottom-nav" style="width: 100%; min-height: 120px; max-height: 150px; align-items: center; background-color: rgba(25, 33, 34, 0.85); border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.2); padding-top: 12px; padding-bottom: 24px;">
            <ui:VisualElement name="bottom-nav-content" style="width: 100%; flex-direction: row;">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; align-items: center;">
                    <ui:VisualElement style="width: 46px; height: 46px; background-image: url('/Assets/Project/Sprites/HomeIcon.png'); -unity-background-image-tint-color: rgb(0, 229, 255); -unity-background-scale-mode: scale-to-fit; margin-bottom: 6px;" />
                    <ui:Label text="Home" style="color: rgb(0, 229, 255); font-size: 18px; -unity-font-style: bold;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; align-items: center; opacity: 0.5;">
                    <ui:VisualElement style="width: 42px; height: 42px; background-image: url('/Assets/Project/Sprites/LockIcon.png'); -unity-background-image-tint-color: rgb(140, 150, 170); -unity-background-scale-mode: scale-to-fit; margin-bottom: 6px;" />
                    <ui:Label text="Lvl 10" style="color: rgb(140, 150, 170); font-size: 18px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; align-items: center; opacity: 0.5;">
                    <ui:VisualElement style="width: 42px; height: 42px; background-image: url('/Assets/Project/Sprites/LockIcon.png'); -unity-background-image-tint-color: rgb(140, 150, 170); -unity-background-scale-mode: scale-to-fit; margin-bottom: 6px;" />
                    <ui:Label text="Lvl 20" style="color: rgb(140, 150, 170); font-size: 18px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; align-items: center; opacity: 0.5;">
                    <ui:VisualElement style="width: 42px; height: 42px; background-image: url('/Assets/Project/Sprites/LockIcon.png'); -unity-background-image-tint-color: rgb(140, 150, 170); -unity-background-scale-mode: scale-to-fit; margin-bottom: 6px;" />
                    <ui:Label text="Lvl 30" style="color: rgb(140, 150, 170); font-size: 18px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; align-items: center; opacity: 0.7;">
                    <ui:VisualElement style="width: 44px; height: 44px; background-image: url('/Assets/Project/Sprites/SettingsIcon.png'); -unity-background-image-tint-color: rgb(180, 190, 200); -unity-background-scale-mode: scale-to-fit; margin-bottom: 6px;" />
                    <ui:Label text="Settings" style="color: rgb(180, 190, 200); font-size: 18px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>