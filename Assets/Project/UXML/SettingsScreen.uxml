<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/SettingsScreen.uss?fileID=7433441132597879392&amp;guid=61f7f2a6d75040d49a64611f413ba112&amp;type=3#SettingsScreen" />
    <ui:Template name="BottomNav" src="project://database/Assets/Project/UXML/BottomNav.uxml" />
    <ui:Template name="AdPlaceholder" src="project://database/Assets/Project/UXML/AdPlaceholder.uxml" />
    <ui:VisualElement name="screen-root" class="screen-root">

        <!-- Layout v2: a round back button, then a large left-aligned title under it, instead of a
             centred title. -->
        <ui:VisualElement name="settings-header" class="settings-header">
            <ui:Button name="settings-back-button" class="settings-back">
                <ui:VisualElement class="settings-back__icon" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label text="SETTINGS" class="settings-title" />
        </ui:VisualElement>

        <ui:ScrollView mode="Vertical" name="settings-scroll" class="settings-scroll" vertical-scroller-visibility="Hidden">
            <ui:VisualElement name="settings-list" class="settings-list">

                <!-- One grouped card: the preference switches, then the links, split by dividers. -->
                <ui:VisualElement name="settings-card" class="card">
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="row__icon row__icon--vibration" picking-mode="Ignore" />
                        <ui:Label text="Vibrations" class="row__label" picking-mode="Ignore" />
                        <ui:VisualElement name="switch-vibration" class="switch">
                            <ui:VisualElement class="switch__knob" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="row row--sep">
                        <ui:VisualElement class="row__icon row__icon--sound" picking-mode="Ignore" />
                        <ui:Label text="Sounds" class="row__label" picking-mode="Ignore" />
                        <ui:VisualElement name="switch-sound" class="switch">
                            <ui:VisualElement class="switch__knob" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="row row--sep">
                        <ui:VisualElement class="row__icon row__icon--refresh" picking-mode="Ignore" />
                        <ui:Label text="Native Refresh Rate" class="row__label" picking-mode="Ignore" />
                        <ui:VisualElement name="switch-refresh" class="switch">
                            <ui:VisualElement class="switch__knob" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="link-rate" class="row row--link row--sep">
                        <ui:VisualElement class="row__icon row__icon--star" picking-mode="Ignore" />
                        <ui:Label text="Rate us" class="row__label" picking-mode="Ignore" />
                        <ui:Label text="&gt;" class="row__chevron" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="link-privacy" class="row row--link row--sep">
                        <ui:VisualElement class="row__icon row__icon--document" picking-mode="Ignore" />
                        <ui:Label text="Privacy" class="row__label" picking-mode="Ignore" />
                        <ui:Label text="&gt;" class="row__chevron" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="link-terms" class="row row--link row--sep">
                        <ui:VisualElement class="row__icon row__icon--info" picking-mode="Ignore" />
                        <ui:Label text="Terms of Service" class="row__label" picking-mode="Ignore" />
                        <ui:Label text="&gt;" class="row__chevron" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:ScrollView>

        <ui:Instance template="BottomNav" name="bottom-nav-slot" class="nav-slot" />

        <!-- Below the nav, same as Home: Android draws the ad over the very bottom of the screen,
             and this only reserves matching room above it. -->
        <ui:VisualElement name="native-ad-space" class="settings-ad-space">
            <ui:Instance template="AdPlaceholder" name="ad-placeholder-slot" class="ad-placeholder-slot" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
