    <ui:VisualElement name="splash-root" style="flex-grow: 1; background-color: rgba(5, 8, 22, 0); background-image: none; -unity-background-scale-mode: scale-and-crop; justify-content: center; align-items: center; width: 100%; height: 100%;">
