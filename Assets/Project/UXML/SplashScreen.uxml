        <ui:Label text="NEON ROUTE ESCAPE" style="color: rgb(0, 229, 255); font-size: 62px; -unity-font-style: bold; padding-left: 2px; -unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&amp;guid=2d8208c2123c041daaecd4a4cf0d1ae2&amp;type=2#Oxanium-Bold SDF&quot;);"/>
        <ui:Label name="subtitle" text="Loading..." style="color: rgb(220, 226, 240); font-size: 42px; -unity-font-style: bold; margin-top: 12px; -unity-font-definition: url(&quot;project://database/Assets/Project/Fonts/Oxanium-Regular.ttf?fileID=12800000&amp;guid=89fa6345cd24145a79a0365efa7553ea&amp;type=3#Oxanium-Regular&quot;); margin-bottom: 10px;"/>
