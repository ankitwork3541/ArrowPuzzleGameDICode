<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/SplashScreen.uss?fileID=7433441132597879392&amp;guid=92e0c9856b36e4c9a9dd9950d373f2e9&amp;type=3#SplashScreen"/>
    <Style src="project://database/Assets/Project/Themes/Typography.uss?fileID=7433441132597879392&amp;guid=6d17c66db56a24fa0841e5265046914b&amp;type=3#Typography"/>

    <!-- Layout v2: name and icon hang from the top, the loading strip sits near the bottom, and the
         middle is left empty on purpose so the drifting backdrop shows through. Both groups are
         absolutely positioned in percent, so they keep their place on any portrait aspect ratio. -->
    <ui:VisualElement name="splash-root" class="splash-root">

        <ui:VisualElement name="splash-top" class="splash-top" picking-mode="Ignore">
            <ui:Label name="title-line-1" text="LANTERN" class="splash-title" picking-mode="Ignore" />
            <ui:Label name="title-line-2" text="DRAGONS" class="splash-title" picking-mode="Ignore" />
            <ui:VisualElement name="app-icon" class="splash-icon" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="splash-bottom" class="splash-bottom" picking-mode="Ignore">
            <ui:Label name="subtitle" text="Loading..." class="splash-caption" picking-mode="Ignore" />
            <ui:ProgressBar name="loading-bar" value="74.6" title="" class="neon-progress" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
