<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/AdPlaceholder.uss" />

    <!-- Skeleton that fills a reserved ad box while the ad itself is still loading, so the screen
         opens the room once instead of jolting when the ad paints. The blocks mirror what the real
         creative puts there: icon, headline, body, call-to-action, and a media area on tall slots.

         Note: `.ad-placeholder-slot` (the <ui:Instance> wrapper) is styled in each host screen's
         stylesheet, the same way `.nav-slot` is. -->
    <ui:VisualElement name="ad-placeholder" class="ad-ph" picking-mode="Ignore">
        <ui:VisualElement class="ad-ph__head" picking-mode="Ignore">
            <ui:VisualElement class="ad-ph__thumb" picking-mode="Ignore" />
            <ui:VisualElement class="ad-ph__lines" picking-mode="Ignore">
                <ui:VisualElement class="ad-ph__line ad-ph__line--title" picking-mode="Ignore" />
                <ui:VisualElement class="ad-ph__line ad-ph__line--body" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="ad-ph__cta" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="ad-ph__media" picking-mode="Ignore" />
        <ui:VisualElement name="ad-placeholder-sheen" class="ad-ph__sheen" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
