<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/BottomNav.uss?fileID=7433441132597879392&amp;guid=d8ac3aa4b7b7430da348be6ecdf383cd&amp;type=3#BottomNav" />
    <ui:VisualElement name="bottom-nav" class="bottom-nav">
        <ui:VisualElement name="nav-home" class="nav-item nav-item--dim">
            <ui:VisualElement class="nav-icon nav-icon--home" picking-mode="Ignore" />
            <ui:Label text="Home" class="nav-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="nav-lvl10" class="nav-item nav-item--locked">
            <ui:VisualElement class="nav-icon nav-icon--lock" picking-mode="Ignore" />
            <ui:Label text="Lvl 10" class="nav-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="nav-lvl20" class="nav-item nav-item--locked">
            <ui:VisualElement class="nav-icon nav-icon--lock" picking-mode="Ignore" />
            <ui:Label text="Lvl 20" class="nav-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="nav-lvl30" class="nav-item nav-item--locked">
            <ui:VisualElement class="nav-icon nav-icon--lock" picking-mode="Ignore" />
            <ui:Label text="Lvl 30" class="nav-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="nav-settings" class="nav-item nav-item--dim">
            <ui:VisualElement class="nav-icon nav-icon--settings" picking-mode="Ignore" />
            <ui:Label text="Settings" class="nav-label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
