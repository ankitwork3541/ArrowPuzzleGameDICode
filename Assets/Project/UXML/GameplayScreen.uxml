<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/GameplayScreen.uss?fileID=7433441132597879392&amp;guid=b4369a12a23684b82832b80a76b589b0&amp;type=3#GameplayScreen" />
    <ui:Template name="AdPlaceholder" src="project://database/Assets/Project/UXML/AdPlaceholder.uxml" />

    <!-- Layout v2 (design/ux/ui-redesign.md): back on the left, the level title centred as plain text
         with the difficulty chip under it, lives as a compact capsule on the right, and the progress
         capsule directly under the title. The three actions live together in ONE floating dock.
         The back button is a rounded square drawn from two sprite layers: the element carries the cream
         paper fill, and a `card-frame` child laid over it carries the coloured edge. They are separate
         because they need different tints, and -unity-background-image-tint-color applies to the whole
         image. Frames are picking-mode="Ignore" so they never swallow a tap meant for their button.
         Everything else is drawn with USS border-radius, so it needs no frame child. -->

    <ui:VisualElement name="gameplay-root" class="gameplay-root">

        <ui:VisualElement name="top-panel" class="top-panel">

            <!-- The title is absolutely centred rather than laid out between back and lives, because the
                 two are different widths — in flow it would sit off-centre by half that difference. -->
            <ui:VisualElement name="top-row" class="top-row">

                <ui:Button name="back-button" class="action-button action-button--small card-fill">
                    <ui:VisualElement class="card-frame card-frame--purple" picking-mode="Ignore" />
                    <ui:VisualElement class="action-button__icon action-button__icon--back" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="title-centre" picking-mode="Ignore">
                    <ui:VisualElement name="level-title" class="level-title" picking-mode="Ignore">
                        <ui:Label text="LEVEL" class="level-title__caption" picking-mode="Ignore" />
                        <ui:Label name="level-number" text="1" class="level-title__number" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="difficulty-chip" class="difficulty-chip" picking-mode="Ignore">
                        <ui:Label name="difficulty-label" text="EASY" class="hud-difficulty" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="lives-pill" class="lives-pill" picking-mode="Ignore">
                    <ui:VisualElement name="hearts" class="hearts" picking-mode="Ignore">
                        <ui:VisualElement name="heart-0" class="heart" />
                        <ui:VisualElement name="heart-1" class="heart" />
                        <ui:VisualElement name="heart-2" class="heart" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- A narrower capsule centred under the title; it no longer doubles as the full-width
                 line that separates the HUD from the board — the opaque top panel does that. -->
            <ui:VisualElement name="progress-track" class="progress-track" picking-mode="Ignore">
                <ui:VisualElement name="progress-fill" class="progress-fill" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- The dock is the measured `bottom-bar` itself, so the camera's board insets and the HUD
             hit-test both see exactly the floating card and nothing around it. -->
        <ui:VisualElement name="bottom-bar" class="bottom-bar">

            <ui:VisualElement class="action">
                <ui:Button name="hint-button" class="action-button dock-button dock-button--teal">
                    <ui:VisualElement name="hint-icon" class="action-button__icon action-button__icon--hint action-button__icon--teal" picking-mode="Ignore" />
                    <ui:VisualElement name="hint-badge" class="hint-badge" picking-mode="Ignore">
                        <ui:Label name="hint-badge-label" text="3" class="hint-badge__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Label text="HINT" class="action__label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="action">
                <ui:Button name="grid-button" class="action-button dock-button dock-button--red">
                    <ui:VisualElement class="action-button__icon action-button__icon--grid action-button__icon--red" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="GRID" class="action__label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="action">
                <ui:Button name="restart-button" class="action-button dock-button dock-button--purple">
                    <ui:VisualElement class="action-button__icon action-button__icon--restart action-button__icon--purple" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="RESTART" class="action__label" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- The ad-loading modal used to live here. It is now a global overlay on its own panel
             (AdLoadingOverlay), because interstitials also fire from home and the result cards. -->

        <ui:VisualElement name="native-ad-space" class="gameplay-ad-space">
            <ui:Instance template="AdPlaceholder" name="ad-placeholder-slot" class="ad-placeholder-slot" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
