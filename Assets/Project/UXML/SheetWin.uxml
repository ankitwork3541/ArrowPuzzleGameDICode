<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/SheetScreen.uss" />
    <ui:Template name="PromoPlaceholder" src="project://database/Assets/Project/UXML/PromoPlaceholder.uxml" />

    <!-- The board behind this panel is world-space and stays on screen; the scrim dims it rather
         than hiding it, so the player still sees the level they just cleared. The confetti is not
         here — ResultScreenController adds it in code, on top of everything.

         Layout v2: the card is a bottom sheet with a round badge half over its top edge. The card
         and the ad box are direct children of the ScrollView: its own content container anchors them
         to the bottom (see .unity-scroll-view__content-container in ResultScreen.uss), so no wrapper
         of ours sits in between to get its width wrong. -->

    <ui:VisualElement name="page-root" class="sheet-root">
        <ui:VisualElement class="sheet-scrim" picking-mode="Ignore" />

        <ui:ScrollView mode="Vertical" name="sheet-scroll" class="sheet-scroll" vertical-scroller-visibility="Hidden">

            <ui:VisualElement name="sheet-card" class="sheet-card">
                <ui:VisualElement class="sheet-badge sheet-badge--win" picking-mode="Ignore">
                    <ui:VisualElement class="sheet-badge__glyph sheet-badge__glyph--win" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:Label name="stage-label" text="LEVEL 01" class="sheet-card__level" picking-mode="Ignore" />
                <ui:Label text="LEVEL COMPLETE" class="sheet-card__title" picking-mode="Ignore" />

                <ui:Button name="go-button" class="sheet-primary">
                    <ui:VisualElement picking-mode="Ignore" class="sheet-primary__inner">
                        <ui:Label text="NEXT" picking-mode="Ignore" class="sheet-primary__label" />
                        <ui:Label text="&gt;" picking-mode="Ignore" class="sheet-primary__chevron" />
                    </ui:VisualElement>
                </ui:Button>

                <ui:Button name="hall-button" text="HOME" class="sheet-home" />
            </ui:VisualElement>

            <ui:VisualElement name="sheet-sponsor-space" class="sheet-sponsor-space">
                <ui:Instance template="PromoPlaceholder" name="ad-placeholder-slot" class="sponsor-slot" />
            </ui:VisualElement>

        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
