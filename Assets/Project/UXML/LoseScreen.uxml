<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/ResultScreen.uss" />
    <ui:Template name="AdPlaceholder" src="project://database/Assets/Project/UXML/AdPlaceholder.uxml" />

    <!-- Same structure as WinScreen, so one controller drives both. What differs is the wording,
         the frame's colour, and that no confetti is added. The board behind is left visible on
         purpose here: the arrows are still sitting where they jammed, which is the information
         the player needs before deciding to retry. -->

    <ui:VisualElement name="screen-root" class="result-root">
        <ui:VisualElement class="result-scrim" picking-mode="Ignore" />

        <ui:ScrollView mode="Vertical" name="result-scroll" class="result-scroll">

            <ui:VisualElement name="result-card" class="result-card">
                <ui:VisualElement class="result-card__frame result-card__frame--lose" picking-mode="Ignore" />

                <ui:Label name="level-label" text="LEVEL 01" class="result-card__level result-card__level--lose" picking-mode="Ignore" />
                <ui:Label text="OUT OF LIVES" class="result-card__title" picking-mode="Ignore" />

                <ui:Button name="primary-button" class="result-primary">
                    <ui:VisualElement picking-mode="Ignore" class="result-primary__inner">
                        <ui:Label text="RETRY" picking-mode="Ignore" class="result-primary__label" />
                    </ui:VisualElement>
                </ui:Button>

                <ui:Button name="home-button" text="HOME" class="result-home" />
            </ui:VisualElement>

            <ui:VisualElement name="dialog-ad-space" class="dialog-ad-space">
                <ui:Instance template="AdPlaceholder" name="ad-placeholder-slot" class="ad-placeholder-slot" />
            </ui:VisualElement>

        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
