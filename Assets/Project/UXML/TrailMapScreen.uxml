<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/TrailMapScreen.uss" />
    <ui:VisualElement name="level-map" class="trail-map">
        <ui:VisualElement class="trail-head">
            <ui:Button name="trail-return-button" class="trail-back">
                <ui:VisualElement class="trail-back__icon" picking-mode="Ignore" />
            </ui:Button>
            <ui:VisualElement class="trail-titles" picking-mode="Ignore">
                <ui:Label name="map-title" text="LEVELS" class="trail-title" picking-mode="Ignore" />
                <ui:Label name="trail-progress" text="0 / 0" class="trail-progress" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ListView name="trail-list" class="trail-list" />
    </ui:VisualElement>
</ui:UXML>
