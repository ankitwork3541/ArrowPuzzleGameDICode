<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/Themes/PlayScreen.uss?fileID=7433441132597879392&amp;guid=b4369a12a23684b82832b80a76b589b0&amp;type=3#GameplayScreen" />
    <ui:Template name="PromoPlaceholder" src="project://database/Assets/Project/UXML/PromoPlaceholder.uxml" />

    <!-- Layout v2 (design/ux/ui-redesign.md): back on the left, the level title centred as plain text
         with the difficulty chip under it, lives as a compact capsule on the right, and the progress
         capsule directly under the title. The three actions live together in ONE floating dock.
         The back button is a rounded square drawn from two sprite layers: the element carries the cream
         paper fill, and a `card-frame` child laid over it carries the coloured edge. They are separate
         because they need different tints, and -unity-background-image-tint-color applies to the whole
         image. Frames are picking-mode="Ignore" so they never swallow a tap meant for their button.
         Everything else is drawn with USS border-radius, so it needs no frame child. -->

    <ui:VisualElement name="gameplay-root" class="play-root">

        <ui:VisualElement name="crown-panel" class="crown-panel">

            <!-- The title is absolutely centred rather than laid out between back and lives, because the
                 two are different widths — in flow it would sit off-centre by half that difference. -->
            <ui:VisualElement name="top-row" class="crown-row">

                <ui:Button name="return-button" class="tool-button tool-button--small paper-fill">
                    <ui:VisualElement class="paper-frame paper-frame--purple" picking-mode="Ignore" />
                    <ui:VisualElement class="tool-button__icon tool-button__icon--back" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement class="heading-centre" picking-mode="Ignore">
                    <ui:VisualElement name="level-title" class="stage-title" picking-mode="Ignore">
                        <ui:Label text="LEVEL" class="stage-title__caption" picking-mode="Ignore" />
                        <ui:Label name="stage-number" text="1" class="stage-title__number" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="difficulty-chip" class="rank-chip" picking-mode="Ignore">
                        <ui:Label name="rank-label" text="EASY" class="rank-caption" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="lives-pill" class="ember-pill" picking-mode="Ignore">
                    <ui:VisualElement name="hearts" class="embers" picking-mode="Ignore">
                        <ui:VisualElement name="heart-0" class="ember" />
                        <ui:VisualElement name="heart-1" class="ember" />
                        <ui:VisualElement name="heart-2" class="ember" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- A narrower capsule centred under the title; it no longer doubles as the full-width
                 line that separates the HUD from the board — the opaque top panel does that. -->
            <ui:VisualElement name="progress-track" class="glow-track" picking-mode="Ignore">
                <ui:VisualElement name="glow-fill" class="glow-fill" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- The dock is the measured `bottom-bar` itself, so the camera's board insets and the HUD
             hit-test both see exactly the floating card and nothing around it. -->
        <ui:VisualElement name="lower-dock" class="lower-dock">

            <ui:VisualElement class="tool">
                <ui:Button name="clue-button" class="tool-button ring-button ring-button--teal">
                    <ui:VisualElement name="clue-icon" class="tool-button__icon tool-button__icon--hint tool-button__icon--teal" picking-mode="Ignore" />
                    <ui:VisualElement name="clue-badge" class="clue-badge" picking-mode="Ignore">
                        <ui:Label name="clue-badge-label" text="3" class="clue-badge__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Label text="HINT" class="tool__label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="tool">
                <ui:Button name="guide-button" class="tool-button ring-button ring-button--red">
                    <ui:VisualElement class="tool-button__icon tool-button__icon--grid tool-button__icon--red" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="GRID" class="tool__label" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="tool">
                <ui:Button name="redo-button" class="tool-button ring-button ring-button--purple">
                    <ui:VisualElement class="tool-button__icon tool-button__icon--restart tool-button__icon--purple" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="RESTART" class="tool__label" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- The ad-loading modal used to live here. It is now a global overlay on its own panel
             (AdLoadingOverlay), because interstitials also fire from home and the result cards. -->

        <ui:VisualElement name="sponsor-space" class="play-sponsor-space">
            <ui:Instance template="PromoPlaceholder" name="ad-placeholder-slot" class="sponsor-slot" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
