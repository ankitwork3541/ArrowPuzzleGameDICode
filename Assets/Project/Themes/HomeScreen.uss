.screen-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
}

.content {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding-left: 60px;
    padding-right: 60px;
}

.level-label {
    font-size: 72px;
    letter-spacing: 8px;
    color: rgb(0, 218, 243);
    text-shadow: 0 0 24px rgba(0, 218, 243, 0.7);
    margin-bottom: 40px;
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-ExtraBold%20SDF.asset?fileID=11400000&guid=a1b658a48c21246d783d8c4f4c297d45&type=2#Oxanium-ExtraBold SDF");
}

.difficulty-pill {
    height: 64px;
    border-radius: 32px;
    background-color: rgb(8, 13, 32);
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.4);
    padding-left: 40px;
    padding-right: 40px;
    justify-content: center;
    align-items: center;
    margin-bottom: 100px;
}

.difficulty-text {
    font-size: 30px;
    letter-spacing: 4px;
    color: rgb(0, 229, 255);
}

/* ============ PLAY button (gradient border) ============ */
.play-button {
    width: 700px;
    height: 160px;
    border-radius: 80px;                 /* height / 2 */
    border-width: 0;
    margin: 0;
    padding: 0;

    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Sprites/NeonGradient.png");
    background-repeat: no-repeat;
    background-size: 100% 100%;          /* stretch — koi 9-slice nahi */
}

.play-button__inner {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    border-radius: 75px;                 /* 80 - 5 */
    background-color: rgba(16, 25, 54, 0.92);

    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.play-button__label {
    font-size: 52px;
    letter-spacing: 6px;
    color: rgb(255, 255, 255);
}

.play-button__chevron {
    font-size: 44px;
    color: rgb(0, 229, 255);
    margin-left: 24px;
}

.play-button:hover .play-button__inner {
    background-color: rgba(22, 36, 81, 0.95);
}

.play-button:active {
    scale: 0.96;
}


/* The bottom nav's markup and styling now live in UXML/BottomNav.uxml +
   Themes/BottomNav.uss, shared with the Settings screen. Only the wrapper the
   <ui:Instance> creates is styled here — it is an element of THIS document, so
   this is the stylesheet guaranteed to reach it. It must never give up space:
   .content above owns all the flex growth. */
.nav-slot {
    flex-shrink: 0;
}

.home-ad-space {
    width: 100%;
    height: 120px;
    flex-shrink: 0;
    display: none;
}
