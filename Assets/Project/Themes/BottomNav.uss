/* ============ Bottom navigation ============
   Shared by every screen that shows the nav (Home, Settings, ...). The markup
   lives in UXML/BottomNav.uxml and is instanced per screen, so these rules are
   the single place the nav's look is defined.

   Which item reads as "selected" is NOT baked in here — BottomNavBinder.cs
   toggles nav-item--active / nav-item--dim per screen. */

/* Note: `.nav-slot` (the <ui:Instance> wrapper) is styled in each host screen's
   own stylesheet, not here — the wrapper element belongs to the host's UXML, so
   that is the stylesheet guaranteed to reach it. */

/* Layout v2: a slim capsule dock that floats a little way in from the screen edges and above the
   bottom, instead of a full-width bar glued to the bottom edge. */
.bottom-nav {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    background-color: rgb(255, 252, 244);
    border-radius: 60px;
    border-width: 3px;
    border-color: rgba(58, 36, 24, 0.12);
    margin-left: 40px;
    margin-right: 40px;
    margin-bottom: 28px;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 12px;
    padding-right: 12px;
}

/* The horizontal padding is deliberate: it widens the tap target of the two
   items that actually navigate, without changing how the row looks. */
.nav-item {
    align-items: center;
    justify-content: center;
    padding-left: 14px;
    padding-right: 14px;
}

.nav-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 4px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.nav-label {
    font-size: 22px;
    letter-spacing: 1px;
    color: rgba(58, 36, 24, 0.6);
}

.nav-icon--home {
    background-image: url("project://database/Assets/Project/Sprites/HomeIcon.png?fileID=7480962188226714435&guid=4400cc3fec59f4399970e2541da7fd71&type=3#HomeIcon_0");
}

.nav-icon--lock {
    background-image: url("project://database/Assets/Project/Sprites/LockIcon.png?fileID=-958580646009965197&guid=d8b1dbdeeae6f406ba936465b9ed71b7&type=3#LockIcon_0");
}

.nav-icon--settings {
    background-image: url("project://database/Assets/Project/Sprites/SettingsIcon.png?fileID=5904627132653970092&guid=6212eb57667724539859a170f6e04832&type=3#SettingsIcon_0");
}

.nav-icon--star {
    background-image: url("project://database/Assets/Project/Sprites/IconStar.png?fileID=461939252480258482&guid=f2339d4101f61414e890ee55ce24ee1a&type=3#IconStar_0");
}

/* ---- states ---- */

/* A soft red capsule behind the selected item, so "you are here" is a shape as well as a colour. */
.nav-item--active {
    background-color: rgba(196, 52, 72, 0.10);
    border-radius: 40px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.nav-item--active .nav-icon {
    -unity-background-image-tint-color: rgb(196, 52, 72);
}

.nav-item--active .nav-label {
    color: rgb(196, 52, 72);
}

.nav-item--locked {
    opacity: 0.5;
}

.nav-item--locked .nav-icon {
    -unity-background-image-tint-color: rgba(58, 36, 24, 0.6);
}

.nav-item--locked .nav-label {
    color: rgba(58, 36, 24, 0.6);
}

/* Gold, not the nav's red: red already means "this is the screen you are on",
   and an earned milestone is a different thing than the current tab. */
.nav-item--unlocked {
    opacity: 1;
}

.nav-item--unlocked .nav-icon {
    -unity-background-image-tint-color: rgb(232, 140, 0);
}

.nav-item--unlocked .nav-label {
    color: rgb(176, 112, 0);
}

.nav-item--dim {
    opacity: 0.7;
}

.nav-item--dim .nav-icon {
    -unity-background-image-tint-color: rgba(58, 36, 24, 0.6);
}

.nav-item--dim .nav-label {
    color: rgba(58, 36, 24, 0.6);
}
