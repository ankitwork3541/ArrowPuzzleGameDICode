/* ============ Root ============
   No background-color on purpose — the grid and arrows are world-space
   GameObjects behind this panel and must stay visible. */
.gameplay-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

/* Held back while the arrows draw themselves in, then faded up. `visibility` is
   what actually blocks clicks — opacity 0 alone still picks up pointer events. */
.gameplay-root--hidden {
    opacity: 0;
    visibility: hidden;
}

/* ============ Octagon chrome ============
   The design's chamfered corners and neon outer glow have no USS equivalent —
   there is border-radius but no clip-path, and text-shadow but no box-shadow —
   so both are baked into sprites. The sprites are drawn white and recoloured
   here, which is why three neon variants cost one file instead of three.

   `.oct` carries the dark interior; `.oct__frame` is an overlay child carrying
   the edge. Two elements, because the two need opposite tints and the tint
   property applies to a whole image.

   Sliced at 44px: the sprite's 24px chamfer plus its 16px glow margin both sit
   inside that, so a stretched badge keeps its corners undistorted. */
.oct {
    background-image: url("../Sprites/UIOctagonFill.png");
    -unity-background-image-tint-color: rgba(12, 18, 42, 0.88);
    -unity-slice-left: 44;
    -unity-slice-top: 44;
    -unity-slice-right: 44;
    -unity-slice-bottom: 44;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.oct__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Sprites/UIOctagonFrame.png");
    -unity-slice-left: 44;
    -unity-slice-top: 44;
    -unity-slice-right: 44;
    -unity-slice-bottom: 44;
}

.oct__frame--cyan    { -unity-background-image-tint-color: rgb(0, 229, 255); }
.oct__frame--magenta { -unity-background-image-tint-color: rgb(255, 43, 214); }
.oct__frame--purple  { -unity-background-image-tint-color: rgb(139, 92, 255); }

/* ============ Top panel ============
   OPAQUE on purpose, and it must match the camera's Solid Color background
   exactly. That is what stops arrows showing through the HUD when the board is
   panned up — no camera clipping or masking needed. Because the two colours are
   identical the panel has no visible edge of its own, so its height is set by
   padding rather than by any drawn boundary. */
.top-panel {
    background-color: rgb(5, 8, 22);
    padding-top: 56px;
    padding-bottom: 34px;
}

.top-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 170px;
}

.top-centre {
    align-items: center;
}

/* ============ LEVEL badge (top-right) ============ */
.level-badge {
    position: absolute;
    right: 36px;
    top: 0;
    height: 150px;
    min-width: 190px;
    padding-left: 34px;
    padding-right: 34px;
    align-items: center;
    justify-content: center;
}

.level-badge__caption {
    font-size: 26px;
    letter-spacing: 4px;
    color: rgba(220, 228, 245, 0.75);
    margin: 0;
}

.level-badge__number {
    font-size: 62px;
    color: rgb(255, 255, 255);
    margin: 0;
    margin-top: -6px;
}

/* ============ Difficulty (top centre) ============ */
.hud-difficulty {
    font-size: 44px;
    letter-spacing: 3px;
    color: rgb(0, 218, 243);
    text-shadow: 0 0 18px rgba(0, 218, 243, 0.6);
    margin: 0;
}

/* ============ Octagon icon buttons ============ */
.oct-button {
    width: 176px;
    height: 176px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

/* Back sits in the top row against the 150px badge, so it runs smaller than the
   bottom bar's action buttons. */
.oct-button--small {
    position: absolute;
    left: 36px;
    top: 15px;
    width: 120px;
    height: 120px;
}

.oct-button:active {
    scale: 0.93;
}

.oct-button__icon {
    width: 68px;
    height: 68px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    -unity-background-image-tint-color: rgba(226, 232, 246, 0.92);
}

.oct-button--small .oct-button__icon {
    width: 48px;
    height: 48px;
}

.oct-button__icon--back    { background-image: url("../Sprites/IconBack.png"); }
.oct-button__icon--restart { background-image: url("../Sprites/IconRestart.png"); }
.oct-button__icon--grid    { background-image: url("../Sprites/IconGrid.png"); }
.oct-button__icon--hint    { background-image: url("../Sprites/IconAd.png"); }

/* Bottom-bar icons wear their button's neon colour; the small back icon stays
   neutral so the top row has exactly one accent in it. */
.oct-button__icon--cyan    { -unity-background-image-tint-color: rgb(0, 229, 255); }
.oct-button__icon--magenta { -unity-background-image-tint-color: rgb(255, 43, 214); }
.oct-button__icon--purple  { -unity-background-image-tint-color: rgb(139, 92, 255); }

/* ============ LIVES pill ============
   Sliced left/right only. The sprite's middle section is a straight bar top and
   bottom, so stretching it vertically as well as horizontally stays correct —
   only the two pointed ends must keep their native width. */
.lives-pill {
    align-self: center;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 104px;
    padding-left: 46px;
    padding-right: 46px;
    margin-top: 24px;

    background-image: url("../Sprites/UIHexPillFill.png");
    -unity-background-image-tint-color: rgba(12, 18, 42, 0.88);
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.lives-pill__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Sprites/UIHexPillFrame.png");
    -unity-background-image-tint-color: rgb(255, 43, 214);
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.lives-pill__caption {
    font-size: 30px;
    letter-spacing: 4px;
    color: rgba(220, 228, 245, 0.8);
    margin: 0;
    margin-right: 22px;
}

.hearts {
    flex-direction: row;
}

.heart {
    width: 50px;
    height: 50px;
    margin-left: 7px;
    margin-right: 7px;
    background-image: url("../Sprites/IconHeart.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    -unity-background-image-tint-color: rgb(255, 43, 214);
}

.heart--empty {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.14);
}

/* ============ Level progress bar ============
   Sits directly under the difficulty label, small, and glowing to match the rest
   of the chrome. Track and fill are both capsule sprites sliced left/right only,
   so the fill animates to any width while its rounded ends keep their shape.

   Deliberately NO overflow:hidden on the track. It would clip the fill's glow off
   at both ends, which is the whole reason the fill is a sprite and not a plain
   background-color — USS has no box-shadow to glow with. */
.progress-track {
    width: 400px;
    height: 24px;
    margin-top: 16px;
    background-image: url("../Sprites/UIBarTrack.png");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.10);
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.progress-fill {
    width: 0;
    height: 100%;
    background-image: url("../Sprites/UIBarFill.png");
    -unity-background-image-tint-color: rgb(0, 229, 255);
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

/* ============ Bottom action bar ============ */
.bottom-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 70px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.action {
    align-items: center;
    margin-left: 34px;
    margin-right: 34px;
}

.action__label {
    font-size: 28px;
    letter-spacing: 3px;
    color: rgba(226, 232, 246, 0.85);
    margin: 0;
    margin-top: 16px;
}

/* Set by the controller when the guide lines are on. */
.grid-button--on .oct-button__icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* ============ Hint button badge & states ============ */
.hint-badge {
    position: absolute;
    right: 8px;
    top: 8px;
    min-width: 44px;
    height: 44px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: 22px;
    background-color: rgb(0, 229, 255);
    align-items: center;
    justify-content: center;
}

.hint-badge--ad {
    background-color: rgb(255, 43, 214);
    min-width: 52px;
}

.hint-badge__label {
    font-size: 24px;
    color: rgb(5, 8, 22);
    margin: 0;
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-ExtraBold%20SDF.asset?fileID=11400000&guid=a1b658a48c21246d783d8c4f4c297d45&type=2#Oxanium-ExtraBold SDF");
}

.oct-button--disabled {
    opacity: 0.35;
}

/* ============ Ad Loading Modal Overlay ============ */
.ad-loading-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    z-index: 100;
}

.ad-loading-modal--hidden {
    display: none;
}

.ad-loading-modal__backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(5, 8, 22, 0.88);
}

.ad-loading-modal__card {
    width: 600px;
    padding: 60px 40px;
    align-items: center;
    justify-content: center;
    background-image: url("../Sprites/UIOctagonFill.png");
    -unity-background-image-tint-color: rgba(12, 18, 42, 0.98);
}

.ad-loading-spinner {
    width: 90px;
    height: 90px;
    background-image: url("../Sprites/Circle01.png");
    -unity-background-image-tint-color: rgb(0, 229, 255);
    margin-bottom: 28px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

.ad-loading-modal__title {
    font-size: 38px;
    letter-spacing: 4px;
    color: rgb(0, 218, 243);
    text-shadow: 0 0 16px rgba(0, 218, 243, 0.6);
    margin: 0;
    margin-bottom: 12px;
}

.ad-loading-modal__subtitle {
    font-size: 24px;
    letter-spacing: 2px;
    color: rgba(220, 228, 245, 0.7);
    margin: 0;
}

/* Last child of gameplay-root, so a measured height pushes the flow up. bottom-bar is absolutely
   positioned and is lifted separately in GameplayHUDController. */
.gameplay-ad-space {
    width: 100%;
    flex-shrink: 0;
    display: none;
}
