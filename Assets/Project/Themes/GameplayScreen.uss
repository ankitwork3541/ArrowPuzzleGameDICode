/* ============ Root ============
   No background-color on purpose — the grid and arrows are world-space
   GameObjects behind this panel and must stay visible. */
.gameplay-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

/* Held back while the arrows draw themselves in, then faded up. `visibility` is
   what actually blocks clicks — opacity 0 alone still picks up pointer events. */
.gameplay-root--hidden {
    opacity: 0;
    visibility: hidden;
}

/* ============ Top panel ============
   OPAQUE on purpose, and it must match the camera's Solid Color background
   exactly. This is what stops arrows from showing above the progress line
   when the board is panned up — no camera clipping or masking needed. */
.top-panel {
    background-color: rgb(5, 8, 22);
    padding-top: 60px;
}

.top-bar {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

/* Both side groups are taken out of the flow so the centre group stays truly
   centred regardless of how wide they are. */
.top-bar__left {
    position: absolute;
    left: 40px;
    top: 0;
    flex-direction: row;
}

.top-bar__center {
    align-items: center;
}

/* ============ Circle icon buttons (back / restart) ============ */
.icon-button {
    width: 110px;
    height: 110px;
    border-radius: 55px;              /* half the height */
    margin: 0;
    padding: 0;

    background-color: rgba(16, 25, 54, 0.85);
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.25);

    background-repeat: no-repeat;
    background-position: center;
    background-size: 50px 50px;
    -unity-background-image-tint-color: rgba(220, 226, 240, 0.9);
}

.icon-button:hover {
    background-color: rgba(22, 36, 81, 0.95);
}

.icon-button:active {
    scale: 0.92;
}

.icon-button--back {
    background-image: url("../Sprites/IconBack.png");
    margin-right: 24px;
}

.icon-button--restart {
    background-image: url("../Sprites/IconRestart.png");
}

/* ============ Hint pill (top-right, flush to the screen edge) ============ */
.hint-pill {
    position: absolute;
    right: 0;
    top: 17px;                        /* vertically centred against the 110px circles */
    height: 76px;

    /* flush right: only the left corners are rounded */
    border-top-left-radius: 38px;
    border-bottom-left-radius: 38px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;

    border-width: 0;
    margin: 0;
    padding-left: 28px;
    padding-right: 34px;

    flex-direction: row;
    align-items: center;

    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Sprites/NeonGradient.png");
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.hint-pill:active {
    scale: 0.95;
}

.hint-pill__icon {
    width: 42px;
    height: 42px;
    margin-right: 14px;
    background-image: url("../Sprites/IconAd.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.hint-pill__label {
    font-size: 40px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
}

/* ============ Difficulty + hearts ============ */
.hud-difficulty {
    font-size: 44px;
    letter-spacing: 2px;
    color: rgb(0, 218, 243);
    text-shadow: 0 0 18px rgba(0, 218, 243, 0.6);
    margin: 0;
}

.hearts {
    flex-direction: row;
    margin-top: 10px;
}

.heart {
    width: 54px;
    height: 54px;
    margin-left: 6px;
    margin-right: 6px;
    background-image: url("../Sprites/IconHeart.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    -unity-background-image-tint-color: rgb(255, 43, 214);
}

.heart--empty {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.12);
}

/* ============ Level progress line ============
   Last child of the opaque top panel, so it reads as the boundary between
   the HUD and the board — exactly like the reference. */
.progress-track {
    height: 8px;
    border-radius: 4px;
    margin-top: 34px;
    margin-left: 40px;
    margin-right: 40px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.progress-fill {
    width: 0;
    height: 100%;
    border-radius: 4px;
    background-color: rgb(0, 229, 255);
}

/* ============ Grid toggle (bottom-right, rounded square) ============ */
.grid-button {
    position: absolute;
    right: 40px;
    bottom: 60px;
    width: 130px;
    height: 130px;
    border-radius: 40px;              /* rounded square, not a circle */
    margin: 0;
    padding: 0;

    background-color: rgba(16, 25, 54, 0.85);
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.2);

    background-image: url("../Sprites/IconGrid.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: 62px 62px;
    -unity-background-image-tint-color: rgba(220, 226, 240, 0.85);
}

.grid-button:hover {
    background-color: rgba(22, 36, 81, 0.95);
}

.grid-button:active {
    scale: 0.92;
}

/* Set by the controller when the guide lines are on. */
.grid-button--on {
    border-color: rgb(0, 229, 255);
    -unity-background-image-tint-color: rgb(0, 229, 255);
}
