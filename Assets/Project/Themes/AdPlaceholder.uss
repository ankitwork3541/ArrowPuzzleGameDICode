/* Styles for the ad-loading skeleton. Shared by every screen that reserves room for an ad, so it
   lives with the template rather than in any one screen's stylesheet. */

.ad-ph {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    justify-content: center;
    padding: 14px 20px;
    background-color: rgba(9, 14, 34, 0.94);
    border-top-width: 1px;
    border-top-color: rgba(0, 229, 255, 0.14);
}

/* Only slots tall enough for a media area get one; AdPlaceholder adds this class. */
.ad-ph--tall {
    justify-content: flex-start;
}

.ad-ph__head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.ad-ph__thumb {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 14px;
    background-color: rgba(0, 229, 255, 0.10);
}

.ad-ph__lines {
    flex-grow: 1;
    margin-left: 18px;
    margin-right: 18px;
}

.ad-ph__line {
    height: 14px;
    border-radius: 7px;
    background-color: rgba(0, 229, 255, 0.10);
}

.ad-ph__line--title {
    width: 62%;
}

.ad-ph__line--body {
    width: 38%;
    margin-top: 12px;
    background-color: rgba(0, 229, 255, 0.06);
}

.ad-ph__cta {
    width: 110px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 19px;
    background-color: rgba(0, 229, 255, 0.14);
}

.ad-ph__media {
    display: none;
}

.ad-ph--tall .ad-ph__media {
    display: flex;
    flex-grow: 1;
    margin-top: 14px;
    border-radius: 14px;
    background-color: rgba(0, 229, 255, 0.06);
}

/* The sweep. A soft radial glow stretched to the full height of the slot reads as a band that fades
   out at both ends, which is what a shimmer needs — a hard-edged rectangle sliding past does not.
   AdPlaceholder moves it; USS has no keyframes. */
.ad-ph__sheen {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    background-image: url("../Sprites/Circle01.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(140, 240, 255, 0.10);
}
