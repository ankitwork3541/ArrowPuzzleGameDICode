/* Styles for the shared ad-loading modal. Self-contained on purpose: this overlay renders on its
   own panel, so it cannot borrow the card rules from any single screen's stylesheet. */

.ring {
    background-image: url("../Sprites/UIRoundFill.png");
    -unity-background-image-tint-color: rgb(255, 252, 244);
    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 40;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ring__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Sprites/UIRoundFrame.png");
    -unity-slice-left: 40;
    -unity-slice-top: 40;
    -unity-slice-right: 40;
    -unity-slice-bottom: 40;
}

.ring__frame--red {
    -unity-background-image-tint-color: rgb(196, 52, 72);
}

/* The font is set here rather than inherited: this overlay is its own panel, so it no longer sits
   under .gameplay-root, which is where the modal used to pick Oxanium up. */
.wait-sheet {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
}

.wait-sheet--hidden {
    display: none;
}

.wait-sheet__backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(58, 36, 24, 0.55);
}

.wait-sheet__card {
    width: 600px;
    padding: 60px 40px;
    align-items: center;
    justify-content: center;
}

/* No background-image: the ring is drawn in AdLoadingOverlay.DrawSpinner via Painter2D, because a
   sprite can only be rotated and a symmetric ring looks identical at every angle. This rule only
   reserves the box it is painted into. */
.wait-spinner {
    width: 90px;
    height: 90px;
    margin-bottom: 28px;
}

.wait-sheet__title {
    font-size: 38px;
    letter-spacing: 4px;
    color: rgb(196, 52, 72);
    margin: 0;
    margin-bottom: 12px;
}

.wait-sheet__subtitle {
    font-size: 24px;
    letter-spacing: 2px;
    color: rgba(58, 36, 24, 0.72);
    margin: 0;
}
