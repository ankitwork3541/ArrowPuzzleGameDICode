.screen-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(5, 8, 22);
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
}

.header {
    padding-top: 50px;
    padding-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 218, 243, 0.25);
}

.title {
    font-size: 40px;
    letter-spacing: 4px;
    color: rgb(0, 218, 243);
    text-shadow: 0 0 20px rgba(0, 218, 243, 0.6);
}

.device-info {
    font-size: 26px;
    color: rgb(150, 165, 190);
    margin-top: 10px;
    white-space: normal;
}

.scroll {
    flex-grow: 1;
}

/* One block per banner type, running the full width of the screen. The ad itself is an Android
   view drawn on top of Unity at full screen width, so the slot cannot be inset — an inset box would
   start the banner past the left edge and push the same amount off the right. Only the text inside
   gets padding. */
.slot {
    margin-top: 34px;
    padding-top: 20px;
    padding-bottom: 20px;
    background-color: rgb(12, 18, 42);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: rgba(0, 218, 243, 0.18);
}

.slot__text {
    padding-left: 30px;
    padding-right: 30px;
}

.slot__title {
    font-size: 32px;
    letter-spacing: 2px;
    color: rgb(255, 43, 214);
}

.slot__note {
    font-size: 24px;
    color: rgb(150, 165, 190);
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 16px;
}

/* Full width, no side margin: this box has to match the banner's own width exactly. Height is set
   from code once the banner reports its real size. The tint makes the reserved box visible even
   before an ad arrives, which is the point of a test screen. */
.slot__space {
    width: 100%;
    height: 0;
    flex-shrink: 0;
    background-color: rgba(0, 218, 243, 0.07);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(0, 218, 243, 0.35);
}

.slot__result {
    font-size: 24px;
    color: rgb(0, 255, 157);
    margin-top: 14px;
    white-space: normal;
}

.slot__warn {
    font-size: 22px;
    color: rgb(255, 193, 7);
    margin-top: 8px;
    white-space: normal;
}

.footer {
    font-size: 22px;
    color: rgb(120, 132, 155);
    white-space: normal;
    margin-top: 34px;
    margin-bottom: 40px;
    margin-left: 30px;
    margin-right: 30px;
}

.close-button {
    height: 90px;
    margin-left: 30px;
    margin-right: 30px;
    margin-bottom: 40px;
    font-size: 30px;
    letter-spacing: 4px;
    color: rgb(5, 8, 22);
    background-color: rgb(0, 218, 243);
    border-radius: 45px;
    border-width: 0;
}
