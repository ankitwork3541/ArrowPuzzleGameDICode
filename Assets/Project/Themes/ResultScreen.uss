/* Shared by WinScreen.uxml and LoseScreen.uxml — the two differ only in wording and accent colour.

   The octagon chrome is redefined here rather than shared with GameplayScreen.uss: USS has no
   import, and pulling the HUD's whole stylesheet into these screens to reuse ten lines would drag
   its layout rules along with it. */

.result-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
}

/* Dims the board rather than covering it. The level stays readable behind the card, which is what
   makes the result feel attached to what just happened instead of being a separate screen. */
.result-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(5, 8, 22, 0.84);
}

/* ============ Card ============
   Same two-layer octagon as the HUD: the element carries the dark fill, a `__frame` child carries
   the neon edge. Two elements because they need opposite tints and the tint property applies to a
   whole image. Sliced at 44px — the sprite's 24px chamfer plus its 16px glow margin both fit
   inside that, so the card stretches without deforming its corners. */
.result-card {
    width: 860px;
    padding-top: 74px;
    padding-bottom: 66px;
    padding-left: 60px;
    padding-right: 60px;
    align-items: center;

    background-image: url("../Sprites/UIOctagonFill.png");
    -unity-background-image-tint-color: rgba(12, 18, 42, 0.96);
    -unity-slice-left: 44;
    -unity-slice-top: 44;
    -unity-slice-right: 44;
    -unity-slice-bottom: 44;
}

.result-card__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("../Sprites/UIOctagonFrame.png");
    -unity-slice-left: 44;
    -unity-slice-top: 44;
    -unity-slice-right: 44;
    -unity-slice-bottom: 44;
}

.result-card__frame--win  { -unity-background-image-tint-color: rgb(0, 229, 255); }
.result-card__frame--lose { -unity-background-image-tint-color: rgb(255, 43, 214); }

.result-card__level {
    font-size: 34px;
    letter-spacing: 8px;
    color: rgb(0, 218, 243);
    text-shadow: 0 0 18px rgba(0, 218, 243, 0.6);
    margin: 0;
    margin-bottom: 18px;
}

.result-card__level--lose {
    color: rgb(255, 90, 200);
    text-shadow: 0 0 18px rgba(255, 43, 214, 0.6);
}

.result-card__title {
    font-size: 72px;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
    margin: 0;
    margin-bottom: 68px;
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-ExtraBold%20SDF.asset?fileID=11400000&guid=a1b658a48c21246d783d8c4f4c297d45&type=2#Oxanium-ExtraBold SDF");
}

/* ============ Primary action ============
   Deliberately the same shape and gradient as Home's PLAY button. This is the "go forward" control
   on every screen that has one, and it should be recognisable as the same thing each time. */
.result-primary {
    width: 620px;
    height: 150px;
    border-radius: 75px;
    border-width: 0;
    margin: 0;
    padding: 0;

    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Sprites/NeonGradient.png");
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.result-primary__inner {
    position: absolute;
    left: 5px;
    top: 5px;
    right: 5px;
    bottom: 5px;
    border-radius: 70px;
    background-color: rgba(16, 25, 54, 0.94);

    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.result-primary__label {
    font-size: 48px;
    letter-spacing: 6px;
    color: rgb(255, 255, 255);
}

.result-primary__chevron {
    font-size: 40px;
    color: rgb(0, 229, 255);
    margin-left: 22px;
}

.result-primary:hover .result-primary__inner {
    background-color: rgba(22, 36, 81, 0.96);
}

.result-primary:active {
    scale: 0.96;
}

/* ============ Secondary action ============ */
.result-home {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    margin-top: 34px;
    padding: 18px;

    font-size: 32px;
    letter-spacing: 6px;
    color: rgba(226, 232, 246, 0.7);
}

.result-home:hover {
    color: rgb(255, 255, 255);
}

.result-home:active {
    scale: 0.94;
}

/* A sibling of the card, not a child: .result-root centres its children as a column, so the card
   and the ad end up centred together as one group on any screen size. Width matches the card so the
   two line up. Height comes from the measured template; display stays none until an ad exists. */
/* ============ Scroll ============
   The card and its ad scroll, so a short screen can still reach the ad instead of losing it off the
   bottom. */
.result-scroll {
    flex-grow: 1;
    width: 100%;
}

/* The centring moved here from .result-root, and this is the whole trick.
   `flex-grow` makes the content container fill the viewport while the card and ad are SHORTER than
   the screen, which is what gives `justify-content: center` free space to centre with — a plain
   content-sized container has none. `flex-shrink: 0` is what stops it being squeezed back down to
   the viewport when they are TALLER; without it the content would be clipped instead of scrolled.
   The container's own height is therefore max(content, viewport), so free space is never negative —
   which is why centring here cannot push the top of the card out of reach. Centring on the ROOT can,
   and that is the trap: a centred group larger than its parent overflows in both directions at once
   and the part above the top edge is unscrollable. */
.result-scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    justify-content: center;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 40px;
}

/* overflow hidden so a box opened to a sliver — which is what happens while the ad's real height is
   still being measured — cannot leak the absolutely-positioned skeleton inside it past its edges. */
.dialog-ad-space {
    width: 100%;
    flex-shrink: 0;
    margin-top: 24px;
    overflow: hidden;
    display: none;
}

/* The <ui:Instance> wrapper around the ad-loading skeleton, styled here the same way `.nav-slot` is.
   Absolute so the skeleton fills whatever height the box was opened to without ever driving it. */
.ad-placeholder-slot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
