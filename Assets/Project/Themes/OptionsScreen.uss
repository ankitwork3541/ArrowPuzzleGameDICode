/* ============ Root ============
   No background-color: the cream camera background behind the panel must stay visible,
   same as the Home screen. */
.page-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-Bold%20SDF.asset?fileID=11400000&guid=2d8208c2123c041daaecd4a4cf0d1ae2&type=2#Oxanium-Bold SDF");
}

/* The wrapper the <ui:Instance> creates for the shared bottom nav. It is an
   element of THIS document, so this is the stylesheet guaranteed to reach it.
   It must never give up space — the ScrollView above owns all the growth. */
.tab-slot {
    flex-shrink: 0;
}

/* Sits under the nav and is grown from the ad's measured height. display:none while there is no
   ad, so nothing reserves a gap that never gets filled. */
.options-sponsor-space {
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
    transition-property: height;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

/* ============ Header ============ */
.options-head {
    align-items: flex-start;
    padding-top: 72px;
    padding-bottom: 36px;
    padding-left: 48px;
    padding-right: 48px;
}

/* Round-cornered square back button, the same language as the HUD and the level map. */
.options-back {
    width: 120px;
    height: 120px;
    margin: 0;
    margin-bottom: 28px;
    padding: 0;
    border-radius: 36px;
    border-width: 6px;
    border-color: rgb(104, 66, 176);
    background-color: rgb(255, 252, 244);
    align-items: center;
    justify-content: center;
}

.options-back:active {
    scale: 0.93;
}

.options-back__icon {
    width: 52px;
    height: 52px;
    background-image: url("../Sprites/GlyphReturn.png");
    scale: 1.6;
    -unity-background-image-tint-color: rgba(58, 36, 24, 0.85);
}

.options-title {
    font-size: 84px;
    letter-spacing: 6px;
    margin: 0;
    -unity-text-align: middle-left;
    color: rgb(58, 36, 24);
    -unity-font-definition: url("project://database/Assets/Project/Fonts/Oxanium-ExtraBold%20SDF.asset?fileID=11400000&guid=a1b658a48c21246d783d8c4f4c297d45&type=2#Oxanium-ExtraBold SDF");
}

/* ============ Scrolling list ============
   A ScrollView from the start, not a plain container: more option groups are
   planned, and swapping the container later would mean restyling everything
   inside it. The padding lives on an inner wrapper so none of ScrollView's own
   nested parts have to be targeted. */
.options-scroll {
    flex-grow: 1;
}

.options-list {
    padding-left: 48px;
    padding-right: 48px;
    padding-bottom: 50px;
}

/* ============ Option group card ============ */
.paper {
    background-color: rgb(255, 252, 244);
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(58, 36, 24, 0.12);
    padding-left: 30px;
    padding-right: 30px;
    margin-bottom: 34px;
}

/* ============ Row ============ */
.entry {
    flex-direction: row;
    align-items: center;
    height: 132px;
}

/* USS has no adjacent-sibling (`+`) selector, so "every row except the first"
   is marked explicitly in the UXML rather than derived. */
.entry--sep {
    border-top-width: 1px;
    border-top-color: rgba(58, 36, 24, 0.12);
}

/* Link rows deliberately have NO :hover / :active highlight — a coloured wash across
   a whole row read as an accidental selection rather than as feedback. */

.entry__icon {
    width: 54px;
    height: 54px;
    margin-right: 28px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    -unity-background-image-tint-color: rgb(196, 52, 72);
}

/* flex-grow pushes whatever follows (switch or chevron) to the right edge. */
.entry__label {
    flex-grow: 1;
    font-size: 36px;
    letter-spacing: 1px;
    color: rgb(58, 36, 24);
}

/* ">" rather than a typographic chevron glyph — the Oxanium SDF atlas is not
   guaranteed to contain "›", and a missing glyph renders as nothing at all. */
.entry__chevron {
    font-size: 38px;
    color: rgba(58, 36, 24, 0.72);
    margin-right: 8px;
}

.entry__icon--vibration {
    background-image: url("../Sprites/GlyphTremor.png");
}

.entry__icon--sound {
    background-image: url("../Sprites/GlyphBell.png");
}

.entry__icon--refresh {
    background-image: url("../Sprites/GlyphPulse.png");
}

.entry__icon--motion {
    background-image: url("../Sprites/GlyphRedo.png");
    scale: 1.2;
}

.entry__icon--star {
    background-image: url("../Sprites/GlyphSeal.png");
    scale: 1.3;
}

.entry__icon--document {
    background-image: url("../Sprites/GlyphScroll.png");
}

.entry__icon--info {
    background-image: url("../Sprites/GlyphNote.png");
}

/* ============ Switch ============
   Built from plain VisualElements instead of ui:Toggle. ui:Toggle renders as a
   checkbox made of nested theme parts that inline styling cannot reach (the same
   trap ProgressBar set on the Splash screen), and this design is a pill switch
   anyway. The knob slides via a USS transition on `left` — no C# animation. */
.toggle {
    width: 104px;
    height: 56px;
    border-radius: 28px;
    background-color: rgba(58, 36, 24, 0.12);
    border-width: 2px;
    border-color: rgba(58, 36, 24, 0.18);
    transition-property: background-color, border-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.toggle__knob {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(58, 36, 24, 0.45);
    transition-property: left, background-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

/* On: solid gold-orange capsule with a cream knob, so on/off differs by position and fill, not
   by hue alone. */
.toggle--on {
    background-color: rgb(232, 140, 0);
    border-color: rgb(232, 140, 0);
}

/* 104 total - 2+2 border - 40 knob - 4 right gap = 56 */
.toggle--on .toggle__knob {
    left: 56px;
    background-color: rgb(255, 248, 236);
}

/* The <ui:Instance> wrapper around the ad-loading skeleton, styled here the same way `.nav-slot` is.
   Absolute so the skeleton fills whatever height the box was opened to without ever driving it. */
.sponsor-slot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
